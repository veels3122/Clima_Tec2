                  <outputColumns>
                    <outputColumn
                      refId="Package\3 Limpieza\Registrar motivo.Outputs[Salida de columna derivada].Columns[destino]"
                      dataType="wstr"
                      errorOrTruncationOperation="Cálculo"
                      errorRowDisposition="FailComponent"
                      length="30"
                      lineageId="Package\3 Limpieza\Registrar motivo.Outputs[Salida de columna derivada].Columns[destino]"
                      name="destino"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión de columna derivada"
                          name="Expression">#{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "" ? "ACEPTADO" : (#{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "clave ya cargada" || #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "duplicado exacto" || #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "duplicado por clave logica" ? "DUPLICADO" : "REVISION_NEGOCIO")</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión descriptiva de columna derivada"
                          expressionType="Notify"
                          name="FriendlyExpression">regla == "" ? "ACEPTADO" : (regla == "clave ya cargada" || regla == "duplicado exacto" || regla == "duplicado por clave logica" ? "DUPLICADO" : "REVISION_NEGOCIO")</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\3 Limpieza\Registrar motivo.Outputs[Salida de columna derivada].Columns[motivo]"
                      dataType="wstr"
                      errorOrTruncationOperation="Cálculo"
                      errorRowDisposition="FailComponent"
                      length="400"
                      lineageId="Package\3 Limpieza\Registrar motivo.Outputs[Salida de columna derivada].Columns[motivo]"
                      name="motivo"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión de columna derivada"
                          name="Expression">SUBSTRING(#{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "clave ya cargada" ? "La clave logica ya existe en clima_limpio (lote " + (DT_WSTR,12)#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[lote_previo]} + "); no se vuelve a cargar." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "duplicado exacto" ? "Fila identica a IdStg " + (DT_WSTR,20)#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[IdStg_conservado]} + " del mismo lote; se conserva esa fila." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "duplicado por clave logica" ? "Misma clave (fuente, nivel, entidad, anio, mes, indicador) que IdStg " + (DT_WSTR,20)#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[IdStg_conservado]} + " con otros valores; se conserva esa fila." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "nulo en campo obligatorio" ? "El campo obligatorio '" + #{Package\3 Limpieza\Estandarizar formatos.Outputs[Salida de columna derivada].Columns[campo_nulo]} + "' viene vacio; no se imputa." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "iso_code nulo en serie nacional" ? "Serie Nacional sin iso_code; solo los agregados Global/Regional lo tienen vacio por diseno." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "mes nulo en serie mensual" ? "La serie es Mensual pero mes viene vacio." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "mes informado en serie anual" ? "La serie es Anual pero trae mes = '" + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[mes]}),""),1,10) + "'." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "fuente_tipo fuera de catalogo" ? "fuente_tipo '" + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[fuente_tipo]}),""),1,40) + "' no es Primaria, Secundaria ni Terciaria." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "nivel_geografico fuera de catalogo" ? "nivel_geografico '" + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[nivel_geografico]}),""),1,40) + "' no es Global, Regional ni Nacional." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "periodicidad fuera de catalogo" ? "periodicidad '" + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[periodicidad]}),""),1,40) + "' no es Anual ni Mensual." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "indicador fuera de catalogo" ? "El indicador '" + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[indicador]}),""),1,100) + "' no existe en cat_indicador." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "unidad inconsistente con el indicador" ? "Unidad '" + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[unidad]}),""),1,50) + "' distinta a la homologada '" + REPLACENULL(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[unidad_catalogo]},"") + "' para el indicador." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "iso_code con formato invalido" ? "iso_code '" + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[iso_code]}),""),1,20) + "' no tiene 3 caracteres." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "texto excede longitud del destino" ? "Un texto supera la longitud de clima_limpio (fuente 150, entidad e indicador 100, unidad 50)." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "anio fuera de dominio" ? "anio " + (DT_WSTR,6)#{Package\3 Limpieza\Tipar columnas.Outputs[Salida de conversion de datos].Columns[anio_num]} + " fuera del rango 2020-2026." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "mes fuera de dominio" ? "mes " + (DT_WSTR,4)#{Package\3 Limpieza\Tipar columnas.Outputs[Salida de conversion de datos].Columns[mes_num]} + " fuera del rango 1-12." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "valor negativo no permitido" ? "valor " + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[valor]}),""),1,30) + " negativo en un indicador que no admite negativos." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "valor excede la precision del destino" ? "valor " + SUBSTRING(REPLACENULL(TRIM(#{Package\3 Limpieza\Leer staging del lote.Outputs[Salida de origen de OLE DB].Columns[valor]}),""),1,30) + " no cabe en DECIMAL(18,4)." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "fecha inconsistente con anio" ? "La fecha " + REPLACENULL(#{Package\3 Limpieza\Estandarizar formatos.Outputs[Salida de columna derivada].Columns[fecha_std]},"") + " no corresponde al anio " + (DT_WSTR,6)#{Package\3 Limpieza\Tipar columnas.Outputs[Salida de conversion de datos].Columns[anio_num]} + "." : #{Package\3 Limpieza\Evaluar reglas.Outputs[Salida de columna derivada].Columns[regla]} == "fecha inconsistente con mes" ? "La fecha " + REPLACENULL(#{Package\3 Limpieza\Estandarizar formatos.Outputs[Salida de columna derivada].Columns[fecha_std]},"") + " no corresponde al mes " + (DT_WSTR,4)#{Package\3 Limpieza\Tipar columnas.Outputs[Salida de conversion de datos].Columns[mes_num]} + "." : "",1,400)</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión descriptiva de columna derivada"
                          expressionType="Notify"
                          name="FriendlyExpression">SUBSTRING(regla == "clave ya cargada" ? "La clave logica ya existe en clima_limpio (lote " + (DT_WSTR,12)lote_previo + "); no se vuelve a cargar." : regla == "duplicado exacto" ? "Fila identica a IdStg " + (DT_WSTR,20)IdStg_conservado + " del mismo lote; se conserva esa fila." : regla == "duplicado por clave logica" ? "Misma clave (fuente, nivel, entidad, anio, mes, indicador) que IdStg " + (DT_WSTR,20)IdStg_conservado + " con otros valores; se conserva esa fila." : regla == "nulo en campo obligatorio" ? "El campo obligatorio '" + campo_nulo + "' viene vacio; no se imputa." : regla == "iso_code nulo en serie nacional" ? "Serie Nacional sin iso_code; solo los agregados Global/Regional lo tienen vacio por diseno." : regla == "mes nulo en serie mensual" ? "La serie es Mensual pero mes viene vacio." : regla == "mes informado en serie anual" ? "La serie es Anual pero trae mes = '" + SUBSTRING(REPLACENULL(TRIM(mes),""),1,10) + "'." : regla == "fuente_tipo fuera de catalogo" ? "fuente_tipo '" + SUBSTRING(REPLACENULL(TRIM(fuente_tipo),""),1,40) + "' no es Primaria, Secundaria ni Terciaria." : regla == "nivel_geografico fuera de catalogo" ? "nivel_geografico '" + SUBSTRING(REPLACENULL(TRIM(nivel_geografico),""),1,40) + "' no es Global, Regional ni Nacional." : regla == "periodicidad fuera de catalogo" ? "periodicidad '" + SUBSTRING(REPLACENULL(TRIM(periodicidad),""),1,40) + "' no es Anual ni Mensual." : regla == "indicador fuera de catalogo" ? "El indicador '" + SUBSTRING(REPLACENULL(TRIM(indicador),""),1,100) + "' no existe en cat_indicador." : regla == "unidad inconsistente con el indicador" ? "Unidad '" + SUBSTRING(REPLACENULL(TRIM(unidad),""),1,50) + "' distinta a la homologada '" + REPLACENULL(unidad_catalogo,"") + "' para el indicador." : regla == "iso_code con formato invalido" ? "iso_code '" + SUBSTRING(REPLACENULL(TRIM(iso_code),""),1,20) + "' no tiene 3 caracteres." : regla == "texto excede longitud del destino" ? "Un texto supera la longitud de clima_limpio (fuente 150, entidad e indicador 100, unidad 50)." : regla == "anio fuera de dominio" ? "anio " + (DT_WSTR,6)anio_num + " fuera del rango 2020-2026." : regla == "mes fuera de dominio" ? "mes " + (DT_WSTR,4)mes_num + " fuera del rango 1-12." : regla == "valor negativo no permitido" ? "valor " + SUBSTRING(REPLACENULL(TRIM(valor),""),1,30) + " negativo en un indicador que no admite negativos." : regla == "valor excede la precision del destino" ? "valor " + SUBSTRING(REPLACENULL(TRIM(valor),""),1,30) + " no cabe en DECIMAL(18,4)." : regla == "fecha inconsistente con anio" ? "La fecha " + REPLACENULL(fecha_std,"") + " no corresponde al anio " + (DT_WSTR,6)anio_num + "." : regla == "fecha inconsistente con mes" ? "La fecha " + REPLACENULL(fecha_std,"") + " no corresponde al mes " + (DT_WSTR,4)mes_num + "." : "",1,400)</property>
                      </properties>
                    </outputColumn>
                  </outputColumns>
